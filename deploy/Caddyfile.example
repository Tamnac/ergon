# Replace ergon.example.com with your domain; Caddy gets a certificate for it automatically.
# If Caddy runs outside docker compose, use localhost:8080 instead of ergon:8080.
ergon.example.com {
	reverse_proxy ergon:8080 {
		# Don't buffer server-sent events (/api/v1/events).
		flush_interval -1
	}
}
